{
  // The windots menu, in the format of omarchy's omarchy-menu.jsonc (omacom/omarchy,
  // config/omarchy/extensions/omarchy-menu.jsonc).
  //
  // IDs are object keys. The parent is the id without its last dotted part, so "style.theme" is
  // inside "style" and "style" is on the root menu. Reusing an id (here or in
  // ~\.config\windots\menu.jsonc) overrides the fields it sets.
  //
  // Fields:
  //   icon         Nerd Font glyph (use \uXXXX) shown in the icon column.
  //   label        Visible row title.   title: heading of the menu (defaults to label).
  //   action       PowerShell command to run (through pwsh, like whkd). No action: it is a submenu.
  //   target       Id of an existing menu to open (a link).
  //   provider     Runtime rows: "themes" or "keybindings".
  //   aliases      Other routes for `windots-launcher summon <route>`; also searchable.
  //   description  Subtitle and extra search text.
  //   when         cmd.exe command; the row is hidden when its exit code is not 0.
  //   checked      cmd.exe command; a check mark when its exit code is 0.
  //   alt          Id of another entry that Shift+Enter runs instead.
  //   confirm      windots addition: the first Enter asks, the second one runs.

  "root": { "label": "Go" },

  // `windots-launcher summon launcher` (Alt+Space): a bare search bar that searches apps, commands, themes, calculations,
  // `> shell` and `kill`. Not a row of the root menu (parent ""), only a route.
  "launcher": { "label": "Launcher", "parent": "", "aliases": ["apps", "run"] },

  // The rest of the root menu follows omarchy's: Apps, Agent, Style, Trigger, Setup, Install, Remove, Update, Learn, About, System.
  "apps": { "icon": "\uf009", "label": "Apps", "target": "launcher", "description": "Search apps, commands, files", "searchTerms": ["aplicativos", "programas"] },

  // Only the agents that are installed show up (`when`: cmd.exe `where`).
  "agent": { "icon": "\uf121", "label": "Agent", "description": "Open an AI agent in a terminal", "searchTerms": ["agente", "ai", "ia"] },
  "agent.claude": { "icon": "\uf121", "label": "Claude", "action": "wt -d \"$env:USERPROFILE\" claude", "when": "where claude >nul 2>&1" },
  "agent.codex": { "icon": "\uf121", "label": "Codex", "action": "wt -d \"$env:USERPROFILE\" codex", "when": "where codex >nul 2>&1" },
  "agent.opencode": { "icon": "\uf121", "label": "OpenCode", "action": "wt -d \"$env:USERPROFILE\" opencode", "when": "where opencode >nul 2>&1" },
  "agent.gemini": { "icon": "\uf121", "label": "Gemini", "action": "wt -d \"$env:USERPROFILE\" gemini", "when": "where gemini >nul 2>&1" },
  "agent.copilot": { "icon": "\uf121", "label": "Copilot", "action": "wt -d \"$env:USERPROFILE\" copilot", "when": "where copilot >nul 2>&1" },

  "style": { "icon": "\uf1fc", "label": "Style", "description": "Theme, font, background", "searchTerms": ["aparencia", "apar\u00eancia", "appearance"] },
  "style.theme": { "icon": "\uf1fc", "label": "Theme", "provider": "themes", "aliases": ["theme", "themes"] },
  "style.font": { "icon": "\uf031", "label": "Font", "action": "windots-install-font", "aliases": ["font", "fonts"] },
  "style.background": { "icon": "\uf03e", "label": "Background", "provider": "backgrounds", "aliases": ["background", "backgrounds", "wallpaper"], "description": "Images of the current theme" },
  "style.darkmode": { "icon": "\uf186", "label": "Dark / light mode", "action": "windots-toggle-dark-mode" },

  "trigger": { "icon": "\uf135", "label": "Trigger", "description": "Capture, speed test, night light", "searchTerms": ["acionar", "capturar"] },
  "trigger.capture": { "icon": "\uf030", "label": "Capture", "searchTerms": ["capturar", "print"] },
  "trigger.capture.screenshot": { "icon": "\uf030", "label": "Screenshot", "action": "start ms-screenclip:", "searchTerms": ["captura de tela", "recorte", "print"] },
  "trigger.capture.screenrecord": { "icon": "\uf03d", "label": "Screen recording", "action": "start snippingtool.exe", "description": "Snipping Tool, its record tab", "searchTerms": ["gravar tela", "gravacao", "video"] },
  "trigger.nightlight": { "icon": "\uf186", "label": "Night light", "action": "start ms-settings:nightlight", "searchTerms": ["luz noturna"] },
  "trigger.speedtest": { "icon": "\uf0e4", "label": "Speed test", "action": "start https://fast.com", "searchTerms": ["velocidade", "internet"] },
  "trigger.share": { "icon": "\uf1e0", "label": "Nearby sharing", "action": "start ms-settings:crossdevice", "searchTerms": ["compartilhar", "share"] },

  "keybindings": { "icon": "\uf11c", "label": "Keybindings", "provider": "keybindings", "aliases": ["keys"], "description": "Every hotkey" },

  "windows": { "icon": "\uf17a", "label": "Settings", "searchTerms": ["windows settings", "configuracoes", "configurações"] },
  "windows.settings": { "icon": "\uf013", "label": "All settings", "action": "start ms-settings:", "searchTerms": ["configuracoes", "preferences"] },
  "windows.background": { "icon": "\uf03e", "label": "Background settings", "action": "start ms-settings:personalization-background" },
  "windows.sound": { "icon": "\uf028", "label": "Sound", "action": "start ms-settings:sound" },
  "windows.bluetooth": { "icon": "\uf293", "label": "Bluetooth", "action": "start ms-settings:bluetooth" },
  "windows.network": { "icon": "\uf1eb", "label": "Network", "action": "start ms-settings:network" },
  "windows.display": { "icon": "\uf108", "label": "Display", "action": "start ms-settings:display" },
  "windows.power": { "icon": "\uf0e7", "label": "Power and sleep", "action": "start ms-settings:powersleep" },

  "setup": { "icon": "\uf013", "label": "Setup", "description": "Restart apps" },
  "setup.restart": { "icon": "\uf021", "label": "Restart an app" },
  "setup.restart.whkd": { "icon": "\uf11c", "label": "whkd (hotkeys)", "action": "windots-restart-whkd" },
  "setup.restart.masir": { "icon": "\uf245", "label": "masir (focus follows mouse)", "action": "windots-restart-masir" },
  "setup.restart.switcher": { "icon": "\uf0c9", "label": "komorebi-switcher", "action": "windots-restart-komorebi-switcher" },
  "setup.restart.explorer": { "icon": "\uf07b", "label": "Explorer (taskbar)", "action": "windots-restart-explorer", "confirm": true },
  "setup.restart.hotkeys": { "icon": "\uf11c", "label": "AutoHotkey script", "action": "windots-restart-hotkeys" },

  // Each one runs in a floating terminal that waits for Enter, so the output can be read.
  "install": { "icon": "\uf0c7", "label": "Install", "description": "windots pieces, fonts, apps", "searchTerms": ["instalar"] },
  "install.font": { "icon": "\uf031", "label": "Font", "action": "windots-install-font", "searchTerms": ["fonte"] },
  "install.packages": { "icon": "\uf187", "label": "Default apps", "action": "windots-launch-or-focus-tui --float --title=install pwsh -NoProfile -Command 'windots reinstall pkgs; Read-Host Enter'", "description": "The winget apps windots expects", "searchTerms": ["pacotes", "aplicativos"] },
  "install.store": { "icon": "\uf290", "label": "Microsoft Store", "action": "start ms-windows-store:", "searchTerms": ["loja"] },
  "install.lazyvim": { "icon": "\uf121", "label": "LazyVim", "action": "windots-launch-or-focus-tui --float --title=install pwsh -NoProfile -Command 'windots install lazyvim; Read-Host Enter'", "searchTerms": ["neovim", "nvim"] },
  "install.files": { "icon": "\uf07b", "label": "Files (file manager)", "action": "windots-launch-or-focus-tui --float --title=install pwsh -NoProfile -Command 'windots install files; Read-Host Enter'", "searchTerms": ["arquivos"] },
  "install.windhawk": { "icon": "\uf1fc", "label": "Windhawk (taskbar style)", "action": "windots-launch-or-focus-tui --float --title=install pwsh -NoProfile -Command 'windots install windhawk; Read-Host Enter'" },

  "remove": { "icon": "\uf014", "label": "Remove", "description": "Uninstall apps, startup items", "searchTerms": ["remover", "desinstalar"] },
  "remove.apps": { "icon": "\uf1f8", "label": "Installed apps", "action": "start ms-settings:appsfeatures", "searchTerms": ["desinstalar", "programas"] },
  "remove.startup": { "icon": "\uf011", "label": "Startup apps", "action": "start ms-settings:startupapps", "searchTerms": ["inicializacao", "inicializa\u00e7\u00e3o"] },
  "remove.files": { "icon": "\uf07b", "label": "Files as default (back to Explorer)", "action": "windots-launch-or-focus-tui --float --title=remove pwsh -NoProfile -Command 'windots install files --no-default; Read-Host Enter'", "confirm": true },

  "update": { "icon": "\uf021", "label": "Update", "description": "windots, apps, Windows", "searchTerms": ["atualizar"] },
  "update.windots": { "icon": "\uf019", "label": "windots (everything)", "action": "windots-launch-or-focus-tui --float --title=update pwsh -NoProfile -Command 'windots update; Read-Host Enter'", "description": "Repository, winget, herdr-app, mise" },
  "update.winget": { "icon": "\uf187", "label": "winget apps", "action": "windots-launch-or-focus-tui --float --title=update pwsh -NoProfile -Command 'windots update winget; Read-Host Enter'" },
  "update.herdr": { "icon": "\uf121", "label": "herdr-app and retropet", "action": "windots-launch-or-focus-tui --float --title=update pwsh -NoProfile -Command 'windots update herdr app; Read-Host Enter'" },
  "update.mise": { "icon": "\uf085", "label": "mise tools", "action": "windots-launch-or-focus-tui --float --title=update pwsh -NoProfile -Command 'windots update mise; Read-Host Enter'" },
  "update.windows": { "icon": "\uf17a", "label": "Windows Update", "action": "start ms-settings:windowsupdate" },

  "learn": { "icon": "\uf19d", "label": "Learn", "description": "Manuals and keys", "searchTerms": ["aprender", "docs", "ajuda"] },
  "learn.keybindings": { "icon": "\uf11c", "label": "Keybindings", "target": "keybindings", "searchTerms": ["atalhos"] },
  "learn.windots": { "icon": "\uf09b", "label": "windots", "action": "start https://github.com/higorhgon/windots#readme" },
  "learn.omarchy": { "icon": "\uf02d", "label": "Omarchy manual", "action": "start https://learn.omacom.io/2/the-omarchy-manual" },
  "learn.komorebi": { "icon": "\uf009", "label": "komorebi", "action": "start https://lgug2z.github.io/komorebi/" },
  "learn.neovim": { "icon": "\uf121", "label": "Neovim (LazyVim)", "action": "start https://www.lazyvim.org/" },
  "learn.powershell": { "icon": "\uf120", "label": "PowerShell", "action": "start https://learn.microsoft.com/powershell/" },

  "about": { "icon": "\uf05a", "label": "About", "action": "start ms-settings:about", "description": "This PC and Windows version", "searchTerms": ["sobre"] },

  "system": { "icon": "\uf011", "label": "System", "description": "Lock, sleep, restart, shut down" },
  "system.lock": { "icon": "\uf023", "label": "Lock", "action": "rundll32.exe user32.dll,LockWorkStation", "searchTerms": ["bloquear"] },
  "system.sleep": { "icon": "\uf236", "label": "Sleep", "action": "rundll32.exe powrprof.dll,SetSuspendState 0,1,0", "searchTerms": ["suspend", "suspender", "dormir"] },
  "system.hibernate": { "icon": "\uf236", "label": "Hibernate", "action": "shutdown /h", "confirm": true, "searchTerms": ["hibernar"] },
  "system.logout": { "icon": "\uf08b", "label": "Log out", "action": "shutdown /l", "confirm": true, "searchTerms": ["sign out", "signout", "logoff", "sair", "encerrar sessao"] },
  "system.restart": { "icon": "\uf021", "label": "Restart", "action": "shutdown /r /t 0", "confirm": true, "searchTerms": ["reboot", "reiniciar"] },
  "system.shutdown": { "icon": "\uf011", "label": "Shut down", "action": "shutdown /s /t 0", "confirm": true, "searchTerms": ["shutdown", "poweroff", "power off", "desligar"] },
  "system.taskmanager": { "icon": "\uf080", "label": "Task Manager", "action": "taskmgr", "searchTerms": ["gerenciador de tarefas", "processes"] },
  "system.recyclebin": { "icon": "\uf1f8", "label": "Open Recycle Bin", "action": "start shell:RecycleBinFolder", "searchTerms": ["lixeira", "trash"] },
  "system.emptyrecyclebin": { "icon": "\uf014", "label": "Empty Recycle Bin", "action": "Clear-RecycleBin -Force -ErrorAction SilentlyContinue", "confirm": true, "searchTerms": ["lixeira", "esvaziar", "trash"] }
}
