<Window x:Class="WindotsLauncher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:menu="clr-namespace:WindotsLauncher.Menu"
        Title="windots-launcher"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="672" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <!-- no default blue: the selected row is the accent colour, faded -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" CornerRadius="8" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SelBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type menu:Row}">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="JetBrainsMonoNL Nerd Font, Segoe Fluent Icons"
                           FontSize="18" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowGlyph, Converter={StaticResource Vis}}" />
                <Image Grid.Column="0" Source="{Binding IconImage}" Width="28" Height="28"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding ShowImage, Converter={StaticResource Vis}}" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <!-- set here, not on the element: a local value would win over the trigger below -->
                            <Setter Property="Grid.Column" Value="1" />
                            <Style.Triggers>
                                <!-- no icon (the keybindings list): use the icon column too, with a margin like the icon's -->
                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                    <Setter Property="Margin" Value="18,0,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Label}" FontSize="15" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasDescription, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,16,0">
                    <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,0,10,0"
                                  Visibility="{Binding HasSwatches, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10" Margin="2,0" Fill="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Right}" FontSize="12" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"
                               Visibility="{Binding HasRight, Converter={StaticResource Vis}}" />
                    <TextBlock Text="&#x2713;" FontSize="15" Margin="10,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                               Visibility="{Binding Checked, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="16" CornerRadius="12" Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- one row, like PowerToys Run: just the search box -->
            <Grid Grid.Row="0" Height="52" Margin="20,0">
                <TextBlock x:Name="Hint" Text="Search..." FontSize="18" Foreground="{DynamicResource Subtle}"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="Filter" FontSize="18" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Accent}"
                         SelectionBrush="{DynamicResource SelBg}" VerticalContentAlignment="Center" Padding="0"
                         TextChanged="Filter_TextChanged" />
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" />

            <ListBox x:Name="List" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,6,0,8"
                     MaxHeight="420" Focusable="False" ItemContainerStyle="{StaticResource RowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" MouseLeftButtonUp="List_MouseLeftButtonUp"
                     SelectionChanged="List_SelectionChanged" />
            </Grid>

            <!-- the image of the selected row, when it has one (the backgrounds list) -->
            <Border x:Name="PreviewPane" Grid.Column="1" Width="400" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <StackPanel Margin="18,18,18,16" VerticalAlignment="Top">
                    <Border x:Name="PreviewSurface" Height="202" CornerRadius="8" Background="{DynamicResource Hover}">
                        <TextBlock x:Name="PreviewHint" Text="" FontSize="13" Foreground="{DynamicResource Subtle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="PreviewTitle" Margin="2,12,2,0" FontSize="15" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PreviewInfo" Margin="2,2,2,0" FontSize="12" Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
