<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>windots-launcher</AssemblyName>
    <RootNamespace>WindotsLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\menus\default.jsonc" Link="menus\default.jsonc" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\menus\searches.jsonc" Link="menus\searches.jsonc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.23" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.23" />
  </ItemGroup>

</Project>
